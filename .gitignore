
# >>> rubio-standards >>>
# Managed by rubio-standards Copier template. Do not edit between sentinels —
# `scripts/merge-gitignore.sh` rewrites this block on every `copier copy/update`.
.DS_Store
.envrc.local
# Machine-local mise overrides (issue #296): the template's sentinel tasks tell
# consumers to override scheme/destination-style config in .mise.local.toml,
# whose recommended header says "gitignored, never committed". Both spellings —
# mise honors mise.local.toml and .mise.local.toml. NOTE: gitignore never
# untracks an already-committed file, so the nested-python convention of a
# COMMITTED .mise.local.toml (dotfiles) keeps working; a NEW repo following
# that convention needs a one-time `git add -f`.
.mise.local.toml
mise.local.toml
*.log
node_modules/
dist/
build/
coverage/
reports/

# .claude deny-block (template/v1.29.0): ignore the whole .claude/ dir EXCEPT
# the committed cloud carrier + hooks/commands/agents. CONTENTS form (.claude/*)
# is mandatory — a dir-form `.claude/` would make the `!` negations silent
# no-ops (git cannot re-include a path under an ignored DIRECTORY). Keeps
# settings.json + hooks/commands/agents trackable while ignoring
# settings.local.json and other local-only .claude/ state.
# The leading `!.claude/` re-includes the directory itself FIRST, so the
# negations below still fire when a parent ignore shadows .claude/ — e.g. a
# developer whose GLOBAL ~/.gitignore ignores `.claude/`. Without it, git
# can't re-include a path whose parent dir is excluded, the carrier is
# silently un-add-able, and MD-09 / CLAUDE-SETTINGS-PLUGIN-BLOCK red-X in CI
# while local check.sh passes. No-op without such a global ignore.
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
!.claude/agents/

# Per-stack
.next/
.vite/
.turbo/
.tsbuildinfo
# <<< rubio-standards <<<
