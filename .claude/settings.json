{
  "extraKnownMarketplaces": {
    "claude-lsps": {
      "source": {
        "source": "github",
        "repo": "Rubio-Enterprises/claude-lsps"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-workflows": {
      "source": {
        "source": "github",
        "repo": "Rubio-Enterprises/claude-workflows"
      }
    },
    "playwright-skills": {
      "source": {
        "source": "github",
        "repo": "Rubio-Enterprises/playwright-skills"
      }
    },
    "rubio": {
      "source": {
        "source": "github",
        "repo": "Rubio-Enterprises/standards"
      }
    },
    "tools-skills": {
      "source": {
        "source": "github",
        "repo": "Rubio-Enterprises/tools-skills"
      }
    }
  },
  "enabledPlugins": {
    "bash-language-server@claude-lsps": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-workflows@claude-workflows": true,
    "code-modernization@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "cue-lsp@claude-lsps": true,
    "mattpocock-skills@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "playwright-skills@playwright-skills": true,
    "pyright@claude-lsps": true,
    "regal-lsp@claude-lsps": true,
    "rubio-standards@rubio": true,
    "session-report@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "tools-skills@tools-skills": true,
    "vtsls@claude-lsps": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start-claude-shim.sh"
          }
        ]
      }
    ]
  }
}
