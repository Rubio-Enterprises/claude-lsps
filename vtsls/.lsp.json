{
  "typescript": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/lsp-proxy.js", "--config", "${CLAUDE_PLUGIN_ROOT}/proxy.json"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  }
}
